{
  "format_version": "1.8.0",
  "animations": {
    "animation.lightsaber.active": {
      "loop": true,
      "bones": {
        "blade": { "scale": [1, 1, 1] }
      }
    },
    "animation.lightsaber.inactive": {
      "loop": true,
      "bones": {
        "blade": { "scale": [1, 0, 1] }
      }
    },
    "animation.lightsaber.deploy": {
      "animation_length": 0.3,
      "bones": {
        "blade": {
          "scale": {
            "0.0": [1, 0, 1],
            "0.3": [1, 1, 1]
          }
        }
      }
    },
    "animation.lightsaber.retract": {
      "animation_length": 0.3,
      "bones": {
        "blade": {
          "scale": {
            "0.0": [1, 1, 1],
            "0.3": [1, 0, 1]
          }
        }
      }
    }
  }
}